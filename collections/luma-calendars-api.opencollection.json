        {
          "info": {
            "name": "Add Event",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://public-api.luma.com/v1/calendar/add-event",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add or submit an existing event (on Luma or on an external platform) to the Luma calendar. By default, events added by a calendar manager are approved immediately. Use `submission_mode: \"pending\"` to keep the submission pending.\n\nOn calendars with `require-manage-access`, submitting a Luma event you manage can also grant the target calendar manage access once the submission is approved."
        },
        {
          "info": {
            "name": "Approve Event",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://public-api.luma.com/v1/calendar/approve-event",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Approve a pending event submission on your calendar. The event becomes visible on the calendar and the submitter is notified."
