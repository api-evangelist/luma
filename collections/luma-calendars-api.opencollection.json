          "http": {
            "method": "GET",
            "url": "https://public-api.luma.com/v1/calendars/coupons/list",
            "params": [
              {
                "name": "pagination_cursor",
                "value": "",
                "type": "query",
                "description": "Value of `next_cursor` from a previous request."
              },
              {
                "name": "pagination_limit",
                "value": "",
                "type": "query",
                "description": "The number of items to return. The server will enforce a maximum number."
              }
            ]
          },
          "docs": "List all coupons that have been created for a calendar."
        },
        {
          "info": {
            "name": "Create Coupon",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://public-api.luma.com/v1/calendars/coupons/create",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a coupon that can be applied to any event that is managed by the calendar. Be careful not to have the same code on an event and on the calendar."
